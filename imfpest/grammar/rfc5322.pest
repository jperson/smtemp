wsp = _{ " " | "\t" }
crlf = _{ "\r\n" }
vchar = _{ '!'..'~' }
comma = _{ "," }
period = _{ "." }
dquote = _{ "\"" }

fws = _{ (wsp* ~ crlf)? ~ wsp+ }
cfws = _{ ((fws? ~ comment){1,} ~ fws?) | fws }
comment = _{ "(" ~ (fws? ~ ccontent)* ~ fws? ~ ")" }
ccontent = _{ ctext | quoted_pair | comment }
ctext = _{ '!'..'&' | '*'..'[' | ']'..'~' }

word            =   _{ atom | quoted_string }
phrase          =   _{ word+ }
unstructured    =   _{ (fws? ~ vchar)* ~ wsp* }

atext           =  _{ ASCII_ALPHA | ASCII_DIGIT |
                       "!" | "#" |
                       "$" | "%" |
                       "&" | "'" |
                       "*" | "+" |
                       "-" | "/" |
                       "=" | "?" |
                       "^" | "_" |
                       "`" | "{" |
                       "|" | "}" |
                       "~"
                   }

atom = _{ cfws? ~ atext+ ~ cfws? }
dot_atom_text = _{ atext+ ~ ("." ~ atext+)* }
dot_atom = _{ cfws? ~ dot_atom_text ~ cfws? }
specials = _{ "(" | ")" | "<" | ">" | "[" | "]" | ":" | ";" | "@" | "\\" | "," | "." | dquote }

/// Quoted pairs
qtext = _{ "!" | '#'..'&' | '*'..'[' }
qcontent = _{ qtext | quoted_pair }
quoted_string = _{ cfws? ~ dquote ~ (fws? ~ qcontent)* ~ fws? ~ dquote ~ cfws? }
quoted_pair = _{ "\\" ~ (vchar | wsp) }


/// Date and time
date_time = { ( day_of_week ~ comma )? ~ date ~ time ~ cfws? }
day_of_week = _{ fws? ~ day_name }
day_name = _{ "Mon" | "Tue" | "Wed" | "Thu" | "Fri" | "Sat" | "Sun" }
date = _{ ( fws? ~ day ~ fws) ~ month ~ (fws ~ year ~ fws) }

day = _{ ASCII_DIGIT{1,2} }
month = _{ "Jan" | "Feb" | "Mar" | "Apr" | "May" | "Jun" | "Jul" | "Aug" | "Sep" | "Oct" | "Nov" | "Dec" }
year = _{ ASCII_DIGIT{4,} }
time = _{ time_of_day ~ (fws ~ zone) }
time_of_day = _{ hour ~ ":" ~ minute ~ (":" ~ second)? }

hour = _{ ASCII_DIGIT{2} }
minute = _{ ASCII_DIGIT{2} }
second = _{ ASCII_DIGIT{2} }

zone = _{ ("+" | "-") ~ ASCII_DIGIT{4} }

trailing_wsp = _{ wsp* ~ crlf }

/// Fields
orig_date = { "Date:" ~ date_time ~ crlf }

from = { "From:" ~ mailbox_list ~ crlf }
sender =    { "Sender:" ~ mailbox ~ crlf }
reply_to =  { "Reply-To:" ~ address_list ~ crlf }
to =  { "To:" ~ address_list ~ crlf }
cc =  { "Cc:" ~ address_list ~ crlf }
bcc = { "Bcc:" ~ (address_list | cfws)? ~ crlf }


message_id =    { "Message-ID:" ~ msg_id ~ crlf }
in_reply_to =   { "In-Reply-To:" ~ msg_id+ ~ crlf }

references =    { "References:" ~ msg_id+ ~ crlf }
msg_id =        _{ cfws? ~ "<" ~ id_left ~ "@" ~ id_right ~ ">" ~ cfws? }
id_left =       { dot_atom_text }
id_right =      { dot_atom_text | no_fold_literal }

no_fold_literal =  { "[" ~ dtext* ~ "]" }

subject = { unstructured }
subject_field =   _{ "Subject:" ~ subject ~ crlf }

comments = { unstructured }
comments_field =  _{ "Comments:" ~ comments ~ crlf }

keywords = { phrase ~ ("," ~ phrase)* }
keywords_field =  _{ "Keywords:" ~ keywords ~ crlf }

resent_date =   { "Resent-Date:" ~ date_time ~ crlf }
resent_from =   { "Resent-From:" ~ mailbox_list ~ crlf }
resent_sender = { "Resent-Sender:" ~ mailbox ~ crlf }
resent_to =     { "Resent-To:" ~ address_list ~ crlf }
resent_cc =     { "Resent-Cc:" ~ address_list ~ crlf }
resent_bcc =    { "Resent-Bcc:" ~ (address_list | cfws)? ~ crlf }
resent_msg_id = { "Resent-Message-ID:" ~ msg_id ~ crlf }

trace           = { return_path? ~ received+ }
return_path     = _{ "Return-Path:" ~ path ~ crlf }
path            = @{ angle_addr | (cfws? ~ "<" ~ cfws? ~ ">" ~ cfws?) }
received        = _{ "Received:" ~ received_token* ~ ";" ~ date_time ~ crlf }
received_token  = _{ domain | word | angle_addr | addr_spec }

opt_field_value = { unstructured }
optional_field  = { field_name ~ ":" ~ opt_field_value ~ crlf }
field_name      = { ftext+ }
ftext           = _{ '!'..'9' | ';'..'~' }

address         = _{ mailbox | group }
mailbox         = _{ name_addr | addr_spec }
name_addr       = _{ display_name? ~ angle_addr }
angle_addr      = _{ cfws? ~ "<" ~ addr_spec ~ ">" ~ cfws? }
group           = { display_name ~ ":" ~ group_list? ~ ";" ~ cfws? }
display_name    = { phrase }
mailbox_list    = _{ mailbox ~ ("," ~ mailbox)* }
address_list    = _{ address ~ ("," ~ address)* }
group_list      = { mailbox_list | cfws }

addr_spec       = _{ local_part ~ "@" ~ domain }
local_part      = { dot_atom | quoted_string }
domain          = { dot_atom | domain_literal }
domain_literal  = _{ cfws? ~ "[" ~ (fws? ~ dtext)* ~ fws? ~ "]" ~ cfws? }
dtext           = { '!'..'Z' | '^'..'~' }

field = _{
    trace |
    resent_date |
    resent_from |
    resent_sender |
    resent_to |
    resent_cc |
    resent_bcc |
    resent_msg_id |
    orig_date |
    from |
    sender |
    reply_to |
    to |
    cc |
    bcc |
    message_id |
    in_reply_to |
    references |
    subject_field |
    comments_field |
    keywords_field |
    optional_field
}

fields = _{ field* }
