WHITESPACE = _{ " " | "\t" }
wsp = _{ " " | "\t" }
fws = _{ (wsp* ~ crlf)? ~ wsp+ }
cfws = _{ ((fws? ~ comment){1,} ~ fws?) | fws }
crlf = _{ "\r\n" }
space = _{ " " }
us_ascii = _{ '!'..'~'}
value = { token | quoted_string }
hex_octet = { "=" ~ (ASCII_DIGIT | "A" | "B" | "C" | "D" | "E" | "F"){2} }
safe_char = { '!'..'<' | '>'..'-' }
comma = _{ "," }

ccontent = _{ ctext | quoted_pair | comment }
ctext = _{ ('!'..'&' | '*'..'[' | ']'..'~') }
qtext = _{ (!("\"" | "\\" | "\r") ~ ASCII) }
quoted_pair = _{ "\\" ~ (us_ascii | wsp) }
quoted_string = { "\"" ~ (qtext | quoted_pair)* ~ "\"" }
dtext = { '!'..'Z' | '^'..'~' }

atom = _{ cfws? ~ atext+ ~ cfws? }
dot_atom_text = _{ atext+ ~ ("." ~ atext+)* }
dot_atom = _{ cfws? ~ dot_atom_text ~ cfws? }

word = _{ atom | quoted_string }
phrase = _{ word+ }

id = { "Content-ID" ~ ":" ~ msg_id }
msg_id = _{ "<" ~ id_left ~ "@" ~ id_right ~ ">"  }
id_left = { dot_atom_text }
id_right = { dot_atom_text | no_fold_literal }
no_fold_literal =  { "[" ~ dtext* ~ "]" }


ptext = { hex_octet | safe_char }
qp_line = { (qp_segment ~ transport_padding ~ crlf)* ~ qp_part ~ transport_padding }
qp_part = { qp_section } // Maximum length of 76 characters
qp_section = { ((ptext | " " | "\t")* ~ ptext)? }
qp_segment = { qp_section ~ (" " | "\t")* ~ "=" } // Maximum length of 76 characters
quoted_printable = { qp_line ~ (crlf ~ qp_line)* }
transport_padding = { wsp* }


tspecials =  _{
    "(" | ")" | "<" | ">" | "@" | "," | ";" | ":" | "\"" | "\\" | "/" | "[" | "]" | "?" | "="
}
text = { !(crlf) ~ ANY }

atext =  _{
    ASCII_ALPHA | ASCII_DIGIT |
   "!" | "#" |
   "$" | "%" |
   "&" | "'" |
   "*" | "+" |
   "-" | "/" |
   "=" | "?" |
   "^" | "_" |
   "`" | "{" |
   "|" | "}" |
   "~"
}

token = { (!( tspecials | " " ) ~ us_ascii )+ }
extension_token = { token }
iana_token = { token }
ietf_token = { token }
x_token = @{ ("X-" | "x-") ~ token }

comment = _{ "(" ~ (ctext | quoted_pair | comment | wsp)* ~ ")" }

/*
NOTE TO IMPLEMENTORS:  When checking MIME-Version values any RFC 822
   comment strings that are present must be ignored.  In particular, the
   following four MIME-Version fields are equivalent:

     MIME-Version: 1.0
     MIME-Version: 1.0 (produced by MetaSend Vx.x)
     MIME-Version: (produced by MetaSend Vx.x) 1.0
     MIME-Version: 1.(produced by MetaSend Vx.x)0
*/

version = { "MIME-Version" ~ ":" ~ version_header }
version_header = _{
    ( unwanted* ~ major ~ "." ~ unwanted* ~ minor ~ unwanted* ) |
    ( unwanted* ~ major ~ unwanted* ~ "." ~ minor ~ unwanted* )
}

major = { ASCII_DIGIT+ }
minor = { ASCII_DIGIT+ }

version_major = _{ (major ~ "." | major) }
version_minor = _{ (minor | "." ~ minor)}
unwanted = _{ !(version_major | version_minor) ~ ANY }

/*
Content type
*/
content = { "Content-Type" ~ ":"  ~ content_type ~ "/" ~ content_subtype ~ (";" ~ parameter)* }
content_type = { (discrete_type | composite_type) }
content_subtype = { extension_token | iana_token }

discrete_type = { ("text" | "image" | "audio" | "video" | "application" | extension_token) }
composite_type = { ("message" | "multipart" | extension_token) }

attribute = { token }
parameter = { attribute ~ "=" ~ value }

description = @{ "Content-Description" ~ ":"  ~ text* }
encoding = @{ "Content-Transfer-Encoding" ~ ":"  ~ mechanism }
mechanism = { "7bit" | "8bit" | "binary" | "quoted-printable" | "base64" | ietf_token | x_token }

MIME_message_headers = { entity_headers ~ fields ~ version ~ crlf }
MIME_part_headers = { entity_headers ~ fields? }
MIME_extension_field = @{ "Content-" ~ (ASCII_ALPHA | "-")+ }

entity_headers = { (content ~ crlf)? ~ (encoding ~ crlf)? ~ (id ~ crlf)? ~ (description ~ crlf)? ~ (MIME_extension_field ~ crlf)* }

address         = _{ mailbox | group }
mailbox         = _{ name_addr | addr_spec }
name_addr       = _{ display_name? ~ angle_addr }
angle_addr      = _{ cfws? ~ "<" ~ addr_spec ~ ">" ~ cfws? }
group           = { display_name ~ ":" ~ group_list? ~ ";" ~ cfws? }
display_name    = { phrase }
mailbox_list    = _{ mailbox ~ ("," ~ mailbox)* }
address_list    = _{ address ~ ("," ~ address)* }
group_list      = { mailbox_list | cfws }

addr_spec       = _{ local_part ~ "@" ~ domain }
local_part      = { dot_atom | quoted_string }
domain          = { dot_atom | domain_literal }
domain_literal  = _{ cfws? ~ "[" ~ (fws? ~ dtext)* ~ fws? ~ "]" ~ cfws? }

destination =  {
    "To" ~ ":" ~ (address ~ ("," ~ address)*) |
    "Resent-To" ~ ":" ~ (address ~ ("," ~ address)*) |
    "cc" ~ ":" ~ (address ~ ("," ~ address)*) |
    "Resent-cc" ~ ":" ~ (address ~ ("," ~ address)*) |
    "bcc" ~ ":" ~ (address ~ ("," ~ address)*)? |
    "Resent-bcc" ~ ":"  ~ (address ~ ("," ~ address)*)?
 }

source = { trace? ~ originator ~ resent? }
trace = { return ~ received+ }
return = { "Return-path" ~ ":" ~ route_addr }
route = { (("@" ~ domain) ~ ("," ~ "@" ~ domain)*) ~ ":" }
route_addr = { "<" ~ route? ~ addr_spec ~ ">" }
received =  {
    "Received" ~ ":" ~ ("from" ~ domain)? ~ ("by" ~ domain)? ~ ("via" ~ atom)? ~ ("with" ~ atom)* ~ ("id" ~ msg_id)? ~ ("for" ~ addr_spec)?
}
originator = { authentic ~ ("Reply-To" ~ ":" ~ (address ~ ("," ~ address)*))? }

authentic = { 
    ("From" ~ ":" ~ mailbox) |
    ("Sender" ~ ":" ~ mailbox ~ "From" ~ ":" ~ (mailbox ~ ("," ~ mailbox)*))
}

resent = { resent_authentic ~ ( "Resent-Reply-To" ~ ":" ~ (address ~ ("," ~ address)*)) }
resent_authentic = {
    "Resent-From" ~ ":" ~ mailbox |
    ( "Resent-Sender" ~ ":" ~ mailbox ~ "Resent-From" ~ ":" ~ (mailbox ~ ("," ~ mailbox)*))
}

dates = { orig_date ~ resent_date? }
orig_date = { "Date" ~ ":" ~ date_time }
resent_date = { "Resent-Date" ~ ":" ~ date_time }

date_time = { ( day_of_week ~ comma )? ~ date ~ time ~ cfws? }
day_of_week = _{ fws? ~ day_name }
day_name = _{ "Mon" | "Tue" | "Wed" | "Thu" | "Fri" | "Sat" | "Sun" }
date = _{ ( fws? ~ day ~ fws) ~ month ~ (fws ~ year ~ fws) }

day = _{ ASCII_DIGIT{1,2} }
month = _{ "Jan" | "Feb" | "Mar" | "Apr" | "May" | "Jun" | "Jul" | "Aug" | "Sep" | "Oct" | "Nov" | "Dec" }
year = _{ ASCII_DIGIT{4,} }
time = _{ time_of_day ~ (fws ~ zone) }
time_of_day = _{ hour ~ ":" ~ minute ~ (":" ~ second)? }

hour = _{ ASCII_DIGIT{2} }
minute = _{ ASCII_DIGIT{2} }
second = _{ ASCII_DIGIT{2} }

zone = _{ ("+" | "-") ~ ASCII_DIGIT{4} }

///  Fields

field = { field_name ~ ":" ~ field_body? ~ crlf }
field_body = @{ field_body_contents ~ (crlf ~ wsp ~ field_body) }
fields = { dates ~ source ~ destination+ ~ optional_field* }

field_body_contents = { ASCII }
field_name  =  { ('!'..'9' | ';'..'~')+ }

optional_field = {
    "Message-ID" ~ ":" ~ msg_id |
    "Resent-Message-ID" ~ ":" ~ msg_id |
    "In-Reply-To" ~ ":" ~ (phrase | msg_id)* |
    "References" ~ ":" ~ (phrase | msg_id)* |
    "Keywords" ~ ":" ~ (phrase ~ ("," ~ phrase)*)? |
    "Subject" ~ ":" ~ text* |
    "Comments" ~ ":" ~ text* |
    "Encrypted" ~ ":" ~ (word ~ ("," ~ word)?)
}
